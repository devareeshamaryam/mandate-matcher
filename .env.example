# --- FCA Register API (https://register.fca.org.uk/Developer) ---
# The FCA API authenticates with BOTH the email you registered with and the key.
FCA_API_EMAIL=
FCA_API_KEY=
# Minimum gap between FCA requests (ms). FCA limits requests per 10s window.
FCA_MIN_INTERVAL_MS=250

# --- Slack (Incoming Webhook URL) ---
SLACK_WEBHOOK_URL=

# --- Google Sheets ---
# Spreadsheet ID from the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Path to a service-account JSON key. Share the sheet with the service account's email (Editor).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# --- Behaviour ---
# Which employees get the extra per-person lookup (roles + cross-firm history): new | all | none
ENRICH_MODE=new
# Cron schedule for `npm start` (default: 07:00 every day, UK time)
CRON_SCHEDULE=0 7 * * *
TZ=Europe/London
# Firms to watch
FIRMS_CONFIG=./config/firms.json

# --- News feeds (config/news.json) ---
# Claude Haiku 4.5 extracts person / from-firm / to-firm from headlines.
ANTHROPIC_API_KEY=
NEWS_ENABLED=true
